{
  "name": "opencode-simulator",
  "version": "0.1.0",
  "type": "module",
  "description": "An OpenCode Desktop plugin that embeds a live iOS Simulator and gives agents tools to drive it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rin-yato/opencode-simulator.git"
  },
  "homepage": "https://github.com/rin-yato/opencode-simulator#readme",
  "bugs": {
    "url": "https://github.com/rin-yato/opencode-simulator/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ios",
    "simulator",
    "xcode",
    "axe",
    "automation",
    "ai"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "vite build",
    "prepublishOnly": "bun run check && bun run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5",
    "expo-device-hub": "0.19.1"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "effect": "4.0.6",
    "electron": "^45.2.1",
    "prettier": "^3.9.10",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
